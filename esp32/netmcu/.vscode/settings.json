{
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "editor.codeActionsOnSave": [],
  "files.associations": {
    "CMakeLists.txt": "cmake",
    "regex": "cpp",
    "*.ipp": "cpp",
    "ctime": "cpp"
  },
      "clang-tidy.buildPath": "build/host-test",
      "window.title": "RV-NetMCU(all)${separator}${activeEditorLong}",
      "cmake.generator": "Ninja",
      "cmake.buildDirectory": "${sourceDirectory}/build",
      "cmake.configureArgs": [
        "-DBUILD_HOST_TESTS=ON"
      ],
      "idf.port": "/dev/ttyUSB2",
      "output.smartScroll.enabled": false,
      "cmake.sourceDirectory": [
        "${workspaceFolder}/configs/host-test",
        "${workspaceFolder}/configs/esp32-debug",
        "${workspaceFolder}/configs/esp32-release",
    ],
      "stm32-for-vscode.openOCDPath": false,
      "C_Cpp.errorSquiggles": "enabled",
      "idf.flashType": "UART",
      "idf.currentSetup": "/home/bertw/.espressif/v5.5.3/esp-idf",
      "idf.monitorPort": "/dev/ttyUSB2",
      "idf.sdkconfigDefaults": ["${workspaceFolder}/configs/esp32-debug/sdkconfig.defaults"],
      "idf.sdkconfigFilePath": "${workspaceFolder}/configs/esp32-debug/sdkconfig",
      "idf.buildPath": "${workspaceFolder}/build/esp32-debug",
}